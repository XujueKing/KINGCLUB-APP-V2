import { MethodCall, MethodCallHandler, MethodResult } from '@ohos/flutter_ohos';
import { common } from '@kit.AbilityKit';
import backgroundTaskManager from '@ohos.resourceschedule.backgroundTaskManager';
import wantAgent from '@ohos.app.ability.wantAgent';

export class CallBackgroundLease implements MethodCallHandler {
  context: common.UIAbilityContext | null = null;
  private activeContext: common.UIAbilityContext | null = null;
  private activeId: string | null = null;
  private epoch: number = 0;
  private cancelled: Set<string> = new Set();
  private queue: Promise<void> = Promise.resolve();
  lost: ((id: string) => void) | null = null;
  private listenerGeneration: number = 0;
  private taskId: number | null = null;
  private listener: ((info: backgroundTaskManager.ContinuousTaskCancelInfo) => void) | null = null;
  private earlyCancellations: Set<number> = new Set();

  private unlisten(): void {
    this.listenerGeneration++;
    try { if (this.listener) backgroundTaskManager.off('continuousTaskCancel', this.listener); } catch (_) {}
    this.listener = null;
    this.earlyCancellations.clear();
  }

  private cancelledBySystem(id: string): void {
    this.activeId = null;
    this.activeContext = null;
    this.taskId = null;
    this.unlisten();
    this.lost?.(id);
  }

  detach(): void {
    this.epoch++;
    this.context = null;
    this.queue = this.queue.then(() => this.stopActive()).catch(() => {});
  }

  onMethodCall(call: MethodCall, result: MethodResult): void {
    if (call.method !== 'start' && call.method !== 'stop') { result.notImplemented(); return; }
    const id = call.argument('id') as string;
    if (typeof id !== 'string' || !/^[a-f0-9-]{36}$/.test(id)) {
      result.error('CALL_LEASE_INVALID', 'Invalid call lease', null); return;
    }
    if (call.method === 'stop') this.cancelled.add(id);
    const revision = this.epoch;
    this.queue = this.queue.then(async () => {
      try {
        if (call.method === 'stop') {
          if (this.activeId === id) await this.stopActive();
          this.cancelled.delete(id);
        } else {
          await this.start(id, revision);
        }
        result.success(null);
      } catch (_) { result.error('CALL_LEASE_UNAVAILABLE', 'Call background service unavailable', null); }
    });
  }

  private async start(id: string, revision: number): Promise<void> {
    const context = this.context;
    if (!context || revision !== this.epoch || this.cancelled.has(id)) throw new Error('cancelled');
    if (this.activeId === id) return;
    if (this.activeId) throw new Error('another call active');
    const agent = await wantAgent.getWantAgent({
      wants: [{bundleName: context.abilityInfo.bundleName, abilityName: context.abilityInfo.name}],
      operationType: wantAgent.OperationType.START_ABILITY,
      requestCode: 4281,
      wantAgentFlags: [wantAgent.WantAgentFlags.UPDATE_PRESENT_FLAG]
    });
    if (revision !== this.epoch || this.cancelled.has(id)) throw new Error('cancelled');
    const generation = ++this.listenerGeneration;
    this.listener = (info: backgroundTaskManager.ContinuousTaskCancelInfo): void => {
      if (revision !== this.epoch || generation !== this.listenerGeneration) return;
      if (this.taskId === null) { this.earlyCancellations.add(info.id); return; }
      if (info.id === this.taskId && this.activeId === id) this.cancelledBySystem(id);
    };
    backgroundTaskManager.on('continuousTaskCancel', this.listener);
    let task: backgroundTaskManager.ContinuousTaskNotification;
    try { task = await backgroundTaskManager.startBackgroundRunning(context, ['voip'], agent); }
    catch (_) { this.unlisten(); throw new Error('background start failed'); }
    this.activeContext = context;
    this.activeId = id;
    this.taskId = task.continuousTaskId ?? null;
    if (this.taskId === null) { await this.stopActive(); throw new Error('task id unavailable'); }
    if (this.earlyCancellations.has(this.taskId)) {
      this.cancelledBySystem(id); throw new Error('task cancelled');
    }
    if (revision !== this.epoch || this.cancelled.has(id)) {
      await this.stopActive();
      throw new Error('cancelled');
    }
  }

  private async stopActive(): Promise<void> {
    const context = this.activeContext;
    if (!context) { this.unlisten(); return; }
    this.unlisten();
    await backgroundTaskManager.stopBackgroundRunning(context);
    this.activeContext = null;
    this.activeId = null;
    this.taskId = null;
  }
}
