import 'package:flutter/services.dart';
import 'package:record_platform_interface/record_platform_interface.dart';
import 'package:record_platform_interface/src/record_platform.dart';

// Keep the shared interface unchanged; await cancellation on OHOS only.
class KingclubRecordOhos extends RecordPlatformImpl {
  static void registerWith() => RecordPlatform.instance = KingclubRecordOhos();
  @override
  Future<void> cancel(String recorderId) =>
      const MethodChannel('com.llfbandit.record/messages')
          .invokeMethod<void>('cancel', {'recorderId': recorderId});
}
